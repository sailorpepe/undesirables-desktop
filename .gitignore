ace_output/

# Secrets
*.stronghold
*.pid
.env*

# Tauri build artifacts (CRITICAL)
src-tauri/target/
src-tauri/gen/
src-tauri/Cargo.lock

# Ensure all node_modules are ignored regardless of path
node_modules/
.next/
out/
src-tauri/binaries/

# Build artifact: CI recreates mcp-dist from source
src-tauri/mcp-dist/
